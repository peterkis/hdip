# 复制为 .env 后修改密码，再执行 make db-init（按这里的账号、密码、库名在本机 PostgreSQL 18 建账号与库）
# 应用运行账号（无 DELETE 权限）
HDIP_DATABASE_URL=postgresql+psycopg://hdip_app:hdip_app@localhost:5432/hdip
# 迁移账号（表属主）
HDIP_MIGRATION_DATABASE_URL=postgresql+psycopg://hdip_owner:hdip_owner@localhost:5432/hdip
# 只决定数据库会话的“现在几点”，存储值不带时区
HDIP_TIMEZONE=Asia/Shanghai
